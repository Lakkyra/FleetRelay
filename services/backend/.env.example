PORT=4000
HOST=0.0.0.0
NODE_ENV=development

# Database (PostgreSQL + PostGIS)
DATABASE_URL=postgresql://fleet_user:fleet_secret_password@localhost:5432/fleetrelay

# Redis for Streams, Geo and Pub/Sub
REDIS_URL=redis://localhost:6379

# Ingestion & Batching
TELEMETRY_BATCH_SIZE=100
TELEMETRY_FLUSH_INTERVAL_MS=500
REDIS_STREAM_NAME=telemetry:stream
REDIS_CONSUMER_GROUP=telemetry_writers

# Geospatial Dispatch Settings
DEFAULT_SEARCH_RADIUS_METERS=5000
DISPATCH_OFFER_TTL_SECONDS=30
MIN_DRIVER_BATTERY_PERCENT=15
MAX_HEARTBEAT_AGE_SECONDS=60
